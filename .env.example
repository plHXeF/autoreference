# Copy this file to .env. Never commit .env.
# The skill/task workflow does not require a model API key.
ANYSEARCH_API_KEY=
OPENALEX_API_KEY=
AUTOREFERENCE_ACCESS_DIR=.autoreference-access
AUTOREFERENCE_CAMPUS_LOGIN_URL=

# Optional legacy model API flow: pip install autoreference[llm].
OPENAI_API_KEY=
AUTOREFERENCE_OPENAI_BASE_URL=https://api.openai.com/v1

# Model names for the optional legacy API flow; configure for your provider.
AUTOREFERENCE_QUERY_MODEL=gpt-5.6-luna
AUTOREFERENCE_JUDGE_MODEL=gpt-5.6-terra

# auto => low for query expansion, high for citation assessment.
# You may also set none/low/medium/high/xhigh/max explicitly.
AUTOREFERENCE_REASONING_EFFORT=auto
AUTOREFERENCE_QUERY_MAX_OUTPUT_TOKENS=4000
AUTOREFERENCE_JUDGE_MAX_OUTPUT_TOKENS=12000

# responses is recommended for OpenAI reasoning models.
# chat_completions is a compatibility fallback for third-party endpoints.
AUTOREFERENCE_API_MODE=responses

# Optional: identifies your client to public scholarly APIs' polite pools.
AUTOREFERENCE_CONTACT_EMAIL=
AUTOREFERENCE_USER_AGENT=AutoReference/0.1 (mailto:your-email@example.com)

# Optional Zhizhen settings. Real campus login requires separate validation.
AUTOREFERENCE_ZHIZHEN_URL=https://www.zhizhen.com/s?&strchoren=1&size=15&isort=0&x=0_7083&sw={query}
AUTOREFERENCE_CHROME_BINARY=
AUTOREFERENCE_CHROMEDRIVER=
AUTOREFERENCE_BROWSER_HEADLESS=true

